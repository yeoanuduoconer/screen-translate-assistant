# Publish only repository files. Local notes, credentials, environments,
# models, logs, screenshots and rollback files stay outside Git.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/requirements.txt
!/启动屏幕翻译助手.cmd

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml

!/docs/
/docs/*
!/docs/architecture.md

!/src/
/src/*
!/src/screen_translator/
/src/screen_translator/*
!/src/screen_translator/*.py
/src/screen_translator/config.py
/src/screen_translator/credentials.py
/src/screen_translator/secrets.py
/src/screen_translator/local_settings.py

!/tests/
/tests/*
!/tests/test_*.py

!/scripts/
/scripts/*
!/scripts/run.ps1
!/scripts/setup.ps1
!/scripts/download_ocr_models.py
!/scripts/benchmark_full_ocr_backends.py
